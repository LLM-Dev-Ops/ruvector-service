{
  "name": "ruvector-service",
  "version": "1.0.0",
  "description": "Thin, stateless API service for RuvVector operations",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.js",
    "test:watch": "jest --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "vector",
    "api",
    "ruvvector"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@llm-dev-ops/contracts": "github:LLM-Dev-Ops/agentics-contracts#1399289526eea46914af82f004580440d11ce8b2",
    "dotenv": "^16.3.1",
    "express": "4.22.3",
    "jsonwebtoken": "9.0.3",
    "jwks-rsa": "3.2.0",
    "pg": "^8.16.3",
    "pino": "^8.16.2",
    "pino-http": "^8.5.1",
    "prom-client": "^15.1.0",
    "uuid": "^11.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.16.0",
    "@types/supertest": "7.2.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "eslint": "8.57.1",
    "jest": "^29.7.0",
    "supertest": "7.3.2",
    "ts-jest": "29.4.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "5.9.3"
  }
}
